{
  "name": "padready",
  "productName": "PadReady",
  "version": "2.1.3",
  "description": "Gets your samples ready for hardware samplers: batch conversion with device presets, powered by SoX.",
  "author": "tristan202",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/tristan202/PadReady.git"
  },
  "scripts": {
    "start": "tauri dev",
    "test": "node --test && npm run test:rust",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "fetch-sox": "node scripts/fetch-sox.js",
    "dist": "npm run fetch-sox && tauri build",
    "dist:portable": "npm run dist && node scripts/portable.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
