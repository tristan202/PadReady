{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PadReady",
  "version": "../package.json",
  "identifier": "com.tristan202.padready",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "PadReady", "width": 1100, "height": 760, "minWidth": 860, "minHeight": 600, "backgroundColor": "#323232" }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../vendor/sox/": "sox/" },
    "windows": {
      "nsis": { "installMode": "both" }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
